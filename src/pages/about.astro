---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';

const principles = [
  { title: 'Make it understandable', text: 'You should know what we recommend, why it matters, and what it will take to move forward.' },
  { title: 'Build it to last', text: 'We favor secure, maintainable solutions that can be supported long after launch day.' },
  { title: 'Work with reality', text: 'The best technical answer depends on your people, priorities, budget, and appetite for change.' },
  { title: 'Stay curious', text: 'Technology keeps changing. We keep learning so new tools—especially AI—can be used thoughtfully.' },
];
---

<BaseLayout
  title="About The Budget Geek"
  description="Learn how The Budget Geek approaches IT support, networks, AI infrastructure, and websites with practical expertise and clear communication."
>
  <section class="page-hero about-hero">
    <div class="container page-hero-grid">
      <div>
        <p class="eyebrow">About us</p>
        <h1>Technology should open doors—not create headaches.</h1>
      </div>
      <p class="page-hero-lead">The Budget Geek helps businesses solve everyday technology problems and confidently explore what comes next.</p>
    </div>
  </section>

  <section class="belief-section">
    <div class="container belief-grid">
      <p class="statement">We believe the best technology partner makes complicated things feel clear.</p>
      <div>
        <p>That starts with listening. Before suggesting a product or drawing a diagram, we want to understand how you work, what is frustrating you, and what a good result actually looks like.</p>
        <p>Whether we are repairing a computer, redesigning a network, building an AI server, or launching a website, the goal is the same: solve the real problem and leave you with something useful.</p>
      </div>
    </div>
  </section>

  <section class="principles-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Our principles</p>
        <h2>How we like to work.</h2>
      </div>
      <div class="principles-grid">
        {principles.map((principle, index) => (
          <article>
            <span>0{index + 1}</span>
            <h3>{principle.title}</h3>
            <p>{principle.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="process-section">
    <div class="container process-grid">
      <div>
        <p class="eyebrow">A practical process</p>
        <h2>Listen. Plan. Build. Support.</h2>
        <p>We keep the process visible, so you always know what is happening and what comes next.</p>
      </div>
      <ol>
        <li><span>01</span><div><h3>Listen first</h3><p>We learn how your people work, where the friction is, and what you need technology to do.</p></div></li>
        <li><span>02</span><div><h3>Make a practical plan</h3><p>We separate urgent issues from valuable improvements and build a sensible path forward.</p></div></li>
        <li><span>03</span><div><h3>Build with care</h3><p>Changes are tested, communicated, documented, and delivered with attention to your daily operations.</p></div></li>
        <li><span>04</span><div><h3>Stick around</h3><p>When the work is finished, we can provide the support and improvements that keep it useful.</p></div></li>
      </ol>
    </div>
  </section>

  <CallToAction title="Looking for a technology partner who speaks human?" />
</BaseLayout>

<style>
  .about-hero { background: radial-gradient(circle at 82% 25%, rgba(103, 232, 210, 0.18), transparent 28%), radial-gradient(circle at 10% 100%, rgba(18, 100, 227, 0.25), transparent 32%), var(--ink); }
  .belief-section { padding: 115px 0; }
  .belief-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(50px, 10vw, 130px); }
  .statement { margin: 0; color: var(--ink); font-family: var(--font-display); font-size: clamp(1.75rem, 3.5vw, 2.75rem); font-weight: 700; line-height: 1.25; letter-spacing: -0.03em; }
  .belief-grid > div { color: var(--slate); font-size: 1.08rem; }

  .principles-section { padding: 110px 0; background: var(--surface); }
  .principles-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .principles-grid article { padding: 34px; border: 1px solid var(--line); background: var(--white); border-radius: var(--radius); }
  .principles-grid span { display: block; margin-bottom: 48px; color: var(--blue); font-size: 0.78rem; font-weight: 800; }
  .principles-grid article p { margin: 0; color: var(--slate); }

  .process-section { padding: 120px 0; color: var(--white); background: var(--ink); }
  .process-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(60px, 10vw, 140px); }
  .process-grid > div > p:last-child { color: #aebdcb; }
  .process-section .eyebrow { color: var(--cyan); }
  .process-section .eyebrow::before { background: var(--cyan); }
  .process-grid ol { margin: 0; padding: 0; list-style: none; }
  .process-grid li { display: grid; padding: 27px 0; grid-template-columns: 48px 1fr; gap: 20px; border-top: 1px solid rgba(255, 255, 255, 0.14); }
  .process-grid li:last-child { border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
  .process-grid li > span { color: var(--cyan); font-size: 0.78rem; font-weight: 800; }
  .process-grid li p { margin: 0; color: #aebdcb; }

  @media (max-width: 780px) {
    .belief-grid, .process-grid { grid-template-columns: 1fr; }
    .principles-grid { grid-template-columns: 1fr; }
  }
</style>
