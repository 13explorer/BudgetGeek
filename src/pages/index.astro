---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';

const services = [
  {
    number: '01',
    title: 'Managed IT Services',
    text: 'Friendly day-to-day support and proactive care that keep your people working and your systems healthy.',
  },
  {
    number: '02',
    title: 'Networks & Repairs',
    text: 'Better Wi-Fi, smarter network design, and responsive break/fix help when something stops working.',
  },
  {
    number: '03',
    title: 'AI & Web Solutions',
    text: 'Private AI servers, practical automation, and fast business websites—planned, built, and supported.',
  },
];
---

<BaseLayout
  title="Managed IT, AI Infrastructure & Websites | The Budget Geek"
  description="The Budget Geek provides managed IT, networking, repairs, private AI infrastructure, and website services with straightforward guidance."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">IT that moves your business forward</p>
        <h1>Less tech stress. More <em>possibility.</em></h1>
        <p class="hero-lead">
          From everyday IT support and rock-solid networks to private AI servers and modern websites, The Budget Geek turns complicated technology into useful solutions.
        </p>
        <div class="hero-actions">
          <a class="button" href="/contact/">Tell us what you need</a>
          <a class="button button-secondary" href="/services/">See what we do</a>
        </div>
      </div>

      <figure class="hero-image">
        <img
          src="/network-hero.jpg"
          alt="Blue network cables connected to a managed network switch"
          width="1280"
          height="853"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <figcaption>
          <span class="status"><span></span> Connected</span>
          <strong>Networks that are built to work.</strong>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="trust-strip" aria-label="Our approach">
    <div class="container trust-items">
      <span>Straight answers</span>
      <span>Practical solutions</span>
      <span>Security built in</span>
      <span>Support that sticks around</span>
    </div>
  </section>

  <section class="services-preview">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">How we can help</p>
        <h2>Start with what’s getting in the way.</h2>
        <p>You might need ongoing support, a stubborn problem fixed, or help building something new. We meet you where you are.</p>
      </div>
      <div class="service-grid">
        {services.map((service) => (
          <article class="service-card">
            <span class="service-number">{service.number}</span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
            <a href="/services/">Learn more <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="why-preview">
    <div class="container why-grid">
      <div>
        <p class="eyebrow">Why choose us</p>
        <h2>Good technology should feel useful—not overwhelming.</h2>
      </div>
      <div class="why-list">
        <article>
          <span>01</span>
          <div><h3>Plain language</h3><p>We explain what is happening, what your options are, and what we recommend without hiding behind jargon.</p></div>
        </article>
        <article>
          <span>02</span>
          <div><h3>Built around your reality</h3><p>Your budget, team, and priorities matter. The right solution is the one that fits your business.</p></div>
        </article>
        <article>
          <span>03</span>
          <div><h3>Here for the whole lifecycle</h3><p>We can plan it, build it, repair it, and keep supporting it after the project is finished.</p></div>
        </article>
      </div>
    </div>
  </section>

  <CallToAction />
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: clamp(82px, 11vw, 145px) 0 105px;
    overflow: hidden;
    color: var(--white);
    background: radial-gradient(circle at 12% 100%, rgba(83, 236, 192, 0.2), transparent 30%), radial-gradient(circle at 82% 14%, rgba(18, 100, 227, 0.38), transparent 26%), #07131f;
  }

  .hero::before {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background-image: linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 48px 48px;
    content: '';
    mask-image: linear-gradient(to bottom, black, transparent 72%);
  }

  .hero-grid {
    position: relative;
    display: grid;
    align-items: center;
    grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
    gap: clamp(50px, 8vw, 100px);
  }

  .hero h1 em { color: var(--cyan); font-style: normal; }
  .hero .eyebrow { color: var(--cyan); }
  .hero .eyebrow::before { background: var(--cyan); }
  .hero-lead { max-width: 670px; margin-bottom: 34px; color: #b7c7d6; font-size: clamp(1.08rem, 2vw, 1.28rem); }
  .hero .button-secondary { border-color: rgba(255, 255, 255, 0.26); color: var(--white); background: transparent; }
  .hero .button-secondary:hover { border-color: var(--white); background: var(--white); color: var(--ink); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }

  .hero-image {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: rgba(13, 32, 50, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    box-shadow: 0 28px 70px rgba(11, 23, 39, 0.2);
  }

  .hero-image::after {
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(to top, rgba(5, 14, 24, 0.96), transparent);
    content: '';
  }

  .hero-image img {
    width: 100%;
    height: 470px;
    object-fit: cover;
    object-position: center;
  }

  .hero-image figcaption {
    position: absolute;
    z-index: 1;
    right: 24px;
    bottom: 24px;
    left: 24px;
    color: var(--white);
  }

  .hero-image figcaption strong {
    display: block;
    margin-top: 10px;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.65rem);
    line-height: 1.2;
  }

  .status { display: flex; align-items: center; gap: 7px; color: #9df3d9; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .status span { width: 7px; height: 7px; background: #57e5b9; border-radius: 50%; box-shadow: 0 0 0 4px rgba(87, 229, 185, 0.14); }

  .trust-strip { border-block: 1px solid var(--line); }
  .trust-items { display: grid; min-height: 86px; align-items: center; grid-template-columns: repeat(4, 1fr); }
  .trust-items span { display: flex; align-items: center; gap: 10px; color: var(--ink-soft); font-size: 0.9rem; font-weight: 700; }
  .trust-items span::before { width: 7px; height: 7px; background: var(--cyan-dark); border-radius: 50%; content: ''; }

  .services-preview, .why-preview { padding: 120px 0; }
  .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }

  .service-card {
    min-height: 330px;
    padding: 32px;
    border: 1px solid var(--line);
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: 0 10px 30px rgba(11, 23, 39, 0.04);
  }

  .service-number { display: block; margin-bottom: 70px; color: var(--blue); font-family: var(--font-display); font-size: 0.82rem; font-weight: 800; }
  .service-card p { color: var(--slate); }
  .service-card a { display: inline-flex; margin-top: 10px; align-items: center; gap: 8px; color: var(--blue-dark); font-weight: 700; text-decoration: none; }

  .why-preview { color: var(--white); background: var(--ink); }
  .why-preview .eyebrow { color: var(--cyan); }
  .why-preview .eyebrow::before { background: var(--cyan); }
  .why-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(50px, 10vw, 130px); }
  .why-list article { display: grid; padding: 27px 0; grid-template-columns: 48px 1fr; gap: 20px; border-top: 1px solid rgba(255, 255, 255, 0.14); }
  .why-list article:last-child { border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
  .why-list article > span { color: var(--cyan); font-family: var(--font-display); font-size: 0.78rem; font-weight: 800; }
  .why-list p { margin: 0; color: #aebdcb; }

  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-image { max-width: 700px; }
    .hero-image img { height: auto; aspect-ratio: 16 / 9; }
    .trust-items, .service-grid { grid-template-columns: repeat(2, 1fr); }
    .trust-items { padding-block: 24px; gap: 16px; }
    .service-card:last-child { grid-column: 1 / -1; }
  }

  @media (max-width: 700px) {
    .hero { padding-top: 65px; }
    .why-grid { grid-template-columns: 1fr; gap: 30px; }
    .service-grid { grid-template-columns: 1fr; }
    .service-card:last-child { grid-column: auto; }
  }

  @media (max-width: 480px) {
    .hero-actions .button { width: 100%; }
    .trust-items { grid-template-columns: 1fr; }
    .hero-image figcaption { right: 18px; bottom: 18px; left: 18px; }
    .services-preview, .why-preview { padding: 85px 0; }
    .service-number { margin-bottom: 45px; }
  }
</style>
