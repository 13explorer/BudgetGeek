---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';

const services = [
  {
    number: '01',
    title: 'Managed IT Services',
    summary: 'A dependable technology partner for day-to-day support, maintenance, and the work that keeps your business moving.',
    details: ['User and device support', 'Monitoring and maintenance', 'Patch and lifecycle planning', 'Documentation and technology planning'],
  },
  {
    number: '02',
    title: 'Network Consulting & Infrastructure',
    summary: 'Networks designed to be reliable, secure, and understandable—from the internet connection to every wired and wireless device.',
    details: ['Network design and upgrades', 'Wi-Fi planning and troubleshooting', 'Firewalls, switching, and cabling', 'Performance and reliability reviews'],
  },
  {
    number: '03',
    title: 'Break/Fix Repairs',
    summary: 'Straightforward help when a computer, network, or office system stops cooperating and you need it working again.',
    details: ['Desktop and laptop troubleshooting', 'Hardware upgrades and repair', 'Network and peripheral issues', 'One-time technical support'],
  },
  {
    number: '04',
    title: 'Cybersecurity, Backup & Recovery',
    summary: 'Practical layers of protection for your people, systems, and data—plus a recovery plan for when something goes wrong.',
    details: ['Security and risk reviews', 'Identity and endpoint protection', 'Backup strategy and implementation', 'Recovery testing and planning'],
  },
  {
    number: '05',
    title: 'Microsoft 365 & Cloud',
    summary: 'Thoughtful setup, migration, and administration for email, collaboration, identity, and the cloud tools your team uses.',
    details: ['Microsoft 365 setup and support', 'Email and data migrations', 'Teams and SharePoint guidance', 'Identity and license management'],
  },
  {
    number: '06',
    title: 'AI Servers & Private AI',
    summary: 'Infrastructure for running AI tools on systems you control, with attention to performance, privacy, and maintainability.',
    details: ['AI server planning and builds', 'GPU and storage architecture', 'Private model deployment', 'Secure access and ongoing support'],
  },
  {
    number: '07',
    title: 'Websites & Hosting',
    summary: 'Fast, accessible websites and practical hosting setups that are easy to maintain and ready to grow with your business.',
    details: ['Business and marketing websites', 'Hosting and deployment', 'Performance and security', 'Updates and ongoing care'],
  },
  {
    number: '08',
    title: 'IT Projects & Consulting',
    summary: 'Clear technical planning and hands-on delivery for upgrades, migrations, and decisions that need to be made carefully.',
    details: ['Infrastructure projects', 'Cloud and system migrations', 'Technology roadmaps', 'Product and vendor evaluation'],
  },
];
---

<BaseLayout
  title="IT, AI & Website Services | The Budget Geek"
  description="Explore managed IT, networking, repairs, cybersecurity, Microsoft 365, private AI infrastructure, website, hosting, and consulting services from The Budget Geek."
>
  <section class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <p class="eyebrow">Services</p>
        <h1>Fix today’s problem. Build what comes next.</h1>
      </div>
      <p class="page-hero-lead">Get help with the technology you already depend on—or a practical partner for your next network, AI, or web project.</p>
    </div>
  </section>

  <section class="service-list-section">
    <div class="container service-list">
      {services.map((service) => (
        <article class="service-row">
          <span class="service-index">{service.number}</span>
          <div class="service-copy">
            <h2>{service.title}</h2>
            <p>{service.summary}</p>
          </div>
          <ul>
            {service.details.map((detail) => <li>{detail}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="engagement-section">
    <div class="container engagement-grid">
      <div class="section-heading">
        <p class="eyebrow">Ways to work together</p>
        <h2>Get the kind of help you actually need.</h2>
        <p>Some businesses want an ongoing technology partner. Others need one problem solved or one new idea brought to life. Both are welcome.</p>
      </div>
      <div class="engagement-cards">
        <article><h3>Ongoing support</h3><p>Responsive help, proactive maintenance, and a technology plan that evolves with your business.</p></article>
        <article><h3>One-time repairs</h3><p>A clear path from “this is broken” to working again, without requiring a long-term contract.</p></article>
        <article><h3>New builds and projects</h3><p>Networks, AI systems, websites, migrations, and upgrades planned and delivered from start to finish.</p></article>
      </div>
    </div>
  </section>

  <CallToAction />
</BaseLayout>

<style>
  .service-list-section { padding: 40px 0 120px; }
  .service-list { border-top: 1px solid var(--line); }

  .service-row {
    display: grid;
    padding: 48px 0;
    grid-template-columns: 70px minmax(260px, 0.9fr) minmax(300px, 1.1fr);
    gap: 30px;
    border-bottom: 1px solid var(--line);
  }

  .service-index { padding-top: 8px; color: var(--blue); font-family: var(--font-display); font-size: 0.78rem; font-weight: 800; }
  .service-row h2 { margin-bottom: 14px; font-size: clamp(1.65rem, 3vw, 2.2rem); }
  .service-copy p { max-width: 490px; margin-bottom: 0; color: var(--slate); }
  .service-row ul { display: grid; margin: 0; padding: 0; align-content: start; grid-template-columns: 1fr 1fr; gap: 12px 24px; list-style: none; }
  .service-row li { position: relative; padding-left: 19px; color: var(--ink-soft); font-size: 0.92rem; }
  .service-row li::before { position: absolute; top: 0.67em; left: 0; width: 7px; height: 7px; background: var(--cyan-dark); border-radius: 50%; content: ''; }

  .engagement-section { padding: 110px 0; color: var(--white); background: var(--ink); }
  .engagement-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(50px, 8vw, 110px); }
  .engagement-section .eyebrow { color: var(--cyan); }
  .engagement-section .eyebrow::before { background: var(--cyan); }
  .engagement-section .section-heading p:last-child { color: #aebdcb; }
  .engagement-cards { display: grid; gap: 12px; }
  .engagement-cards article { padding: 26px 28px; border: 1px solid rgba(255, 255, 255, 0.11); background: rgba(255, 255, 255, 0.035); border-radius: 14px; }
  .engagement-cards article p { margin: 0; color: #aebdcb; }

  @media (max-width: 850px) {
    .service-row { grid-template-columns: 46px 1fr; }
    .service-row ul { grid-column: 2; }
    .engagement-grid { grid-template-columns: 1fr; gap: 20px; }
  }

  @media (max-width: 560px) {
    .service-row { grid-template-columns: 1fr; gap: 10px; }
    .service-row ul { grid-column: auto; grid-template-columns: 1fr; margin-top: 16px; }
  }
</style>
